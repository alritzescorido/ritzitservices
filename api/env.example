# Copy to api/.env for local development (cp env.example .env). Never commit .env.
NODE_ENV=development
PORT=3000

# Local, no Docker: PostgreSQL in-process (PGlite), stored under api/.data/lpb.
# With DB_AUTO_SCHEMA=true an empty database gets db/schema.sql and the PSGC seed.
DATABASE_URL=pglite://./.data/lpb
DB_AUTO_SCHEMA=true
# Staging/production: PostgreSQL 15 + PostGIS, schema applied by the migration step.
# DATABASE_URL=postgres://lpb:lpb@localhost:5432/lpb
# DB_AUTO_SCHEMA=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me-change-me

# console = print codes to the server log. OTP_DEV_CODE fixes the code for local testing; unset it outside dev.
SMS_PROVIDER=console
OTP_DEV_CODE=123456
