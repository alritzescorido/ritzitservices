# Copy to api/.env for local development (cp env.example .env). Never commit .env.
NODE_ENV=development
PORT=3000

# Local, no Docker: PostgreSQL in-process (PGlite), stored under api/.data/lpb.
# With DB_AUTO_SCHEMA=true an empty database gets db/schema.sql and the PSGC seed.
DATABASE_URL=pglite://./.data/lpb
DB_AUTO_SCHEMA=true
# Staging/production: PostgreSQL 15 + PostGIS, schema applied by the migration step.
# DATABASE_URL=postgres://lpb:lpb@localhost:5432/lpb
# DB_AUTO_SCHEMA=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me-change-me

# console = print codes to the server log. OTP_DEV_CODE fixes the code for local testing; unset it outside dev.
SMS_PROVIDER=console
OTP_DEV_CODE=123456

# Booking deposits (decision 3). off = no deposit asked (deals as before).
# fake = in-process gateway for demos and tests: the checkout link opens a page with a "Pay" button.
# paymongo = real gateway; set the two keys and register PUBLIC_BASE_URL/v1/payments/webhook at PayMongo.
PAYMENTS_PROVIDER=fake
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
# DEPOSIT_PERCENT=10
# DEPOSIT_MIN_PESOS=2000
# DEPOSIT_MAX_PESOS=20000
# DEPOSIT_PAY_WINDOW_MINUTES=120
# PAYMENTS_RETURN_URL=http://localhost:3000/v1/payments/return
# Settled deals per buyer per rolling week before further ones are held for admin review.
# SETTLEMENTS_PER_BUYER_PER_WEEK=20

# Platform commission as a percent of the deal estimate, added to what the buyer pays
# on top of the booking deposit. Zero means no fee is charged at all, which is the
# default: switching it on is a business decision, not a deployment detail.
# It is only collectible where a deposit is taken, because the balance never passes
# through the platform. Farmers are never charged; see docs/development-plan.md.
# COMMISSION_PERCENT=1.5
